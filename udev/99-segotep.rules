# udev rule for Segotep Ice Moon / Digital series AIO coolers
# Vendor ID: 0x1a86 (WCH / QinHeng Electronics), Product ID: 0xa001
# Allows non-root users (logged-in session or members of 'input' / 'plugdev') to communicate with the HID device

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="a001", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="a001", MODE="0666", TAG+="uaccess"
